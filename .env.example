# Server-only. Never prefix these with NEXT_PUBLIC.

# Amazon Creators API (Login with Amazon client credentials)
AMAZON_CREATORS_CREDENTIAL_ID=your-credential-id
AMAZON_CREATORS_CREDENTIAL_SECRET=your-credential-secret
AMAZON_CREATORS_CREDENTIAL_VERSION=3.1
AMAZON_CREATORS_PARTNER_TAG=your-partner-tag
AMAZON_CREATORS_MARKETPLACE=www.amazon.com
AMAZON_CREATORS_RPS=1

# Catalog search cache (seconds). Keep short; show "Price as of" in the UI.
PRODUCT_CACHE_TTL_SECONDS=3600

# Wayfair via CJ Affiliate product data feed (stub — search returns [])
WAYFAIR_CJ_FEED_URL=https://example.invalid/wayfair-cj-feed
WAYFAIR_FEED_ENABLED=false

# Walmart Affiliate API via Impact (stub — search returns [])
WALMART_AFFILIATE_PUBLISHER_ID=your-publisher-id
WALMART_AFFILIATE_CONSUMER_ID=your-consumer-id
WALMART_AFFILIATE_PRIVATE_KEY_PATH=/path/to/private-key.pem
WALMART_AFFILIATE_ENABLED=false

# AI image render (NoopRenderer ignores this; no network calls)
AI_RENDER_ENABLED=false
